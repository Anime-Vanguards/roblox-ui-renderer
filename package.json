{
  "name": "roblox-ui-renderer",
  "version": "0.3.0",
  "private": true,
  "description": "Offline Roblox UI renderer: runs Vide/UI Labs stories and .rbxm trees in an emulated engine and renders them at Studio parity.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anime-Vanguards/roblox-ui-renderer.git"
  },
  "type": "module",
  "bin": {
    "rur": "cli/rur.mjs"
  },
  "scripts": {
    "rur": "node cli/rur.mjs",
    "native": "node cli/native.mjs",
    "native:build": "node tools/native-app/build.mjs",
    "native:prepare": "node tools/native-app/build.mjs --prepare",
    "native:check": "node tools/native-app/build.mjs --check",
    "test": "node cli/rur.mjs selftest"
  },
  "dependencies": {
    "opentype.js": "^1.3.4",
    "pngjs": "^7.0.0"
  }
}
