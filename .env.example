# Copy this file to .env in the renderer repo root and set your Roblox account cookie below.
# Paste the .ROBLOSECURITY value, optionally including its .ROBLOSECURITY= prefix.
# Keep .env private; it is ignored by Git. Restart the renderer after changing this file.
ROBLOX_ASSET_DELIVERY_COOKIE=

# Only the asset cookie is read from .env; it does not configure other renderer options.
# This repo's .env is checked first on Windows and macOS, regardless of the working directory.
# Without a nonempty cookie here, inherited ROBLOX_ASSET_DELIVERY_COOKIE (or ROBLOSECURITY) is tried.
# RUR_COOKIE_ENV in the process environment selects a fallback file after those sources.
# No other file is read. Values are literal: no shell commands or variable expansion.
