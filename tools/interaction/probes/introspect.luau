-- Read-only: what the MCP execution context can reach (no GUI, no input).
local Results = {}
local function Try(Name, Callback)
	local Ok, Value = pcall(Callback)
	Results[Name] = if Ok then tostring(Value) else "ERROR: " .. tostring(Value)
end

Try("plugin", function()
	return typeof(plugin) .. " " .. tostring(plugin)
end)
Try("script", function()
	return typeof(script) .. " " .. tostring(script)
end)
Try("identity", function()
	return getfenv and tostring(getfenv(0).script) or "?"
end)
Try("CreateVirtualInput", function()
	local Virtual = game:GetService("UserInputService"):CreateVirtualInput()
	return typeof(Virtual) .. " " .. tostring(Virtual)
end)
Try("VirtualUser", function()
	local VirtualUser = game:GetService("VirtualUser")
	return typeof(VirtualUser)
end)
Try("MouseLocation", function()
	return tostring(game:GetService("UserInputService"):GetMouseLocation())
end)
Try("LastInputType", function()
	return tostring(game:GetService("UserInputService"):GetLastInputType())
end)
Try("ViewportSize", function()
	return tostring(workspace.CurrentCamera.ViewportSize)
end)
Try("GuiInset", function()
	local A, B = game:GetService("GuiService"):GetGuiInset()
	return tostring(A) .. " / " .. tostring(B)
end)
Try("TopbarInset", function()
	return tostring(game:GetService("GuiService").TopbarInset)
end)
Try("Selection", function()
	return #game:GetService("Selection"):Get()
end)
Try("CanUndo", function()
	local History = game:GetService("ChangeHistoryService")
	local CanUndo, Name = History:GetCanUndo()
	return tostring(CanUndo) .. " " .. tostring(Name)
end)
Try("CoreGuiAt", function()
	local List = game:GetService("CoreGui"):GetGuiObjectsAtPosition(10, 10)
	return #List
end)
Try("LocalPlayer", function()
	return tostring(game:GetService("Players").LocalPlayer)
end)
Try("RunState", function()
	local RunService = game:GetService("RunService")
	return `edit={RunService:IsEdit()} running={RunService:IsRunning()}`
end)
Try("MouseBehavior", function()
	return tostring(game:GetService("UserInputService").MouseBehavior)
end)
Try("MouseEnabled", function()
	local UIS = game:GetService("UserInputService")
	return `mouse={UIS.MouseEnabled} keyboard={UIS.KeyboardEnabled} touch={UIS.TouchEnabled}`
end)

return game:GetService("HttpService"):JSONEncode(Results)
